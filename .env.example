APP_NAME=xhs-health
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///xhs_health.sqlite3
# Local development only. Use a secret manager and a strong random value in production.
APP_API_TOKEN=xhs-local-dev-token
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=3600
XHS_CONNECTOR_MODE=manual

# Scoring/alert tuning (all optional; see ScoreThresholds in
# src/xhs_health/services/scoring.py for the full list of SCORE_* variables).
# SCORE_ANALYSIS_WINDOW_DAYS=30
# SCORE_ALERT_LOW_SCORE=55
# SCORE_ALERT_INACTIVE_DAYS=14

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=
